# Repository-level ignores.

# Python and tooling caches. The venv is 1 GB and entirely regenerable with `uv sync`.
*/__pycache__/
*/.pytest_cache/
*/.venv/
*.py[cod]
.ruff_cache/

# Per-run output. Every file here is regenerated by `cardetect run` and is named after the
# run's start time, so committing it would add a new directory on every invocation.
yolo-cardetect/runs/

# Model weights. Downloaded on first use by Ultralytics, or exported locally for an edge
# target; either way they are a build artefact, not source.
*.pt
*.onnx
*.rknn
*_ncnn_model/

# Generated sample footage. Regenerate with:
#   uv run python -m cardetect.tools.make_synthetic_video --config config/camera_topdown.yaml
yolo-cardetect/samples/*.mp4
